<script>
const STOPS = [
  {e:'🍺', label:'Boston',    km:0,    opt:false},
  {e:'🍻', label:'Connolly',  km:2.8,  opt:false},
  {e:'🥃', label:'Рус.Паб',   km:1.6,  opt:false},
  {e:'🌸', label:'Гейша',     km:0,    opt:true},
  {e:'🔥', label:'BBQ',       km:3.6,  opt:false},
  {e:'⚽', label:'Люкс',      km:0,    opt:false},
];
const KM_PER_STEP = 0.00075;
const TOTAL_WALK_KM = 2.8 + 1.6 + 3.6;
const TOTAL_STEPS = Math.round(TOTAL_WALK_KM / KM_PER_STEP / 1000) * 1000;

function renderSteps(done) {
  const inner = document.getElementById('stepsInner');
  inner.innerHTML = '';
  STOPS.forEach((s, i) => {
    const node = document.createElement('div');
    node.className = 'st-node';
    const dot = document.createElement('div');
    dot.className = 'st-dot' + (s.opt ? ' opt' : '') + (i < done ? ' done' : '');
    dot.textContent = s.e;
    const lbl = document.createElement('div');
    lbl.className = 'st-label';
    lbl.textContent = s.label;
    node.appendChild(dot);
    node.appendChild(lbl);
    inner.appendChild(node);
    if (i < STOPS.length - 1) {
      const line = document.createElement('div');
      line.className = 'st-line' + (i < done - 1 ? ' done' : '');
      inner.appendChild(line);
    }
  });

  const counter = document.getElementById('stepsCounter');
  const kmEl = document.getElementById('stepsKm');
  if (done === 0) {
    counter.innerHTML = 'День ещё не начался — все локации впереди';
    kmEl.textContent = '';
  } else {
    const nonOpt = STOPS.slice(0, done).filter(s => !s.opt);
    const walkedKm = nonOpt.reduce((a, s) => a + s.km, 0);
    const walkedSteps = Math.round(walkedKm / KM_PER_STEP);
    counter.innerHTML = `Пройдено локаций: <b>${done} из ${STOPS.length}</b>`;
    if (walkedKm > 0) {
      kmEl.textContent = `~${walkedSteps.toLocaleString()} шагов пешком · ${walkedKm.toFixed(1)} км`;
    }
  }
}

const PARTICIPANTS = [
  {name:'Митяй',    initials:'МТ', color:'#f5a623', status:'go',    stops:0},
  {name:'Коротей',  initials:'КР', color:'#2dd4a0', status:'go',    stops:0},
  {name:'Чернов',   initials:'ЧН', color:'#a78bfa', status:'go',    stops:0},
  {name:'Субботин', initials:'СБ', color:'#ff6b4a', status:'go',    stops:0},
  {name:'Каш',      initials:'КШ', color:'#e879a0', status:'go',    stops:0},
  {name:'Захаров',  initials:'ЗХ', color:'#4ade80', status:'go',    stops:0},
  {name:'Чича',     initials:'ЧЧ', color:'#60a5fa', status:'go',    stops:0},
  {name:'Маркел',   initials:'МК', color:'#f472b6', status:'go',    stops:0},
  {name:'Юра',      initials:'ЮР', color:'#fb923c', status:'go',    stops:0},
  {name:'Дикий',    initials:'ДК', color:'#34d399', status:'go',    stops:0},
  {name:'Леха',     initials:'ЛХ', color:'#818cf8', status:'go',    stops:0},
  {name:'Вердян',   initials:'ВД', color:'#f5a623', status:'go',    stops:0},
];
const SL = {go:'Иду',nope:'Не иду',maybe:'Думаю'};
const SC = {go:'sgo',nope:'snope',maybe:'smaybe'};

function renderParticipants() {
  const pg = document.getElementById('pg');
  pg.innerHTML = '';
  PARTICIPANTS.forEach(p => {
    const pc = document.createElement('div');
    pc.className = 'pc';
    const av = document.createElement('div');
    av.className = 'av';
    av.style.cssText = `background:${p.color}1a;border:1px solid ${p.color}44;color:${p.color}`;
    av.textContent = p.initials;
    const nm = document.createElement('div');
    nm.className = 'pname';
    nm.textContent = p.name;
    const st = document.createElement('div');
    st.className = `pst ${SC[p.status]}`;
    st.textContent = SL[p.status];
    const sp = document.createElement('div');
    sp.className = 'pstops';
    sp.textContent = `${p.stops} из ${STOPS.length} локаций`;
    const dots = document.createElement('div');
    dots.className = 'sdots';
    STOPS.forEach((_, i) => {
      const d = document.createElement('div');
      d.className = 'sdot' + (i < p.stops ? ' on' : '');
      dots.appendChild(d);
    });
    sp.appendChild(dots);
    pc.append(av, nm, st, sp);
    pg.appendChild(pc);
  });
}

// Примерный счётчик шагов внизу страницы — суммарно по маршруту
const totalStepsInfo = document.createElement('div');
totalStepsInfo.style.cssText = 'font-size:12px;color:var(--muted2);margin-top:6px;';
totalStepsInfo.textContent = `Весь маршрут пешком: ~${TOTAL_STEPS.toLocaleString()} шагов · ${TOTAL_WALK_KM.toFixed(1)} км`;
document.getElementById('stepsKm').after(totalStepsInfo);

renderSteps(0);
renderParticipants();
</script>


