<!-- PROGRAM -->
<div class="sec-title">Программа</div>
<div class="tl">

  <!-- 1 BOSTON -->
  <div class="tl-row">
    <div class="spine"><div class="tl-icon">🍺</div><div class="vline"></div></div>
    <div class="card">
