<style>
@import url('https://fonts.googleapis.com/css2?family=Unbounded:wght@400;700;900&family=Inter:wght@400;500;600&display=swap');
:root {
  --bg:#0d0d0f; --s1:#16161a; --s2:#1e1e24; --border:rgba(255,255,255,0.08);
  --amber:#f5a623; --adim:rgba(245,166,35,0.12); --aglow:rgba(245,166,35,0.3);
  --teal:#2dd4a0; --tdim:rgba(45,212,160,0.1);
  --coral:#ff6b4a; --cdim:rgba(255,107,74,0.1);
  --pink:#e879a0; --pdim:rgba(232,121,160,0.1);
  --purple:#a78bfa; --vdim:rgba(167,139,250,0.1);
  --red:#f87171; --rdim:rgba(248,113,113,0.1);
  --green:#4ade80; --gdim:rgba(74,222,128,0.1);
  --text:#f0ede8; --muted:#7a7a8a; --muted2:#3a3a4a;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;font-size:15px;line-height:1.6;}

/* NAV */
.nav{position:sticky;top:0;z-index:100;background:rgba(13,13,15,0.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:52px;}
.nav-title{font-family:'Unbounded',sans-serif;font-size:11px;font-weight:700;color:var(--amber);letter-spacing:0.05em;}
.nav-links{display:flex;gap:4px;}
.nav-links a{font-size:12px;color:var(--muted);text-decoration:none;padding:5px 10px;border-radius:6px;transition:all 0.2s;}
.nav-links a:hover{color:var(--text);background:var(--s2);}

/* HERO */
.hero{padding:4rem 1.5rem 3rem;text-align:center;position:relative;overflow:hidden;border-bottom:1px solid var(--border);}
.hero-glow{position:absolute;top:-80px;left:50%;transform:translateX(-50%);width:500px;height:300px;background:radial-gradient(ellipse,rgba(245,166,35,0.12) 0%,transparent 70%);pointer-events:none;}
.hero-eyebrow{font-family:'Unbounded',sans-serif;font-size:10px;font-weight:400;letter-spacing:0.25em;color:var(--muted);text-transform:uppercase;margin-bottom:1.25rem;}
.hero-title{font-family:'Unbounded',sans-serif;font-size:clamp(22px,6vw,48px);font-weight:900;line-height:1.05;letter-spacing:-0.02em;margin-bottom:0.5rem;}
.hero-title .g{color:var(--amber);}
.hero-date{font-family:'Unbounded',sans-serif;font-size:clamp(14px,3vw,20px);font-weight:400;color:var(--muted);margin-bottom:1.75rem;}
.hero-pills{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;}
.pill{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:100px;font-size:13px;font-weight:500;border:1px solid;}
.pa{background:var(--adim);border-color:var(--aglow);color:var(--amber);}
.pt{background:var(--tdim);border-color:rgba(45,212,160,0.3);color:var(--teal);}
.pp{background:var(--vdim);border-color:rgba(167,139,250,0.3);color:var(--purple);}

/* STEPS */
.steps-wrap{background:var(--s1);border-bottom:1px solid var(--border);padding:1.5rem;}
.section-label{font-family:'Unbounded',sans-serif;font-size:10px;font-weight:400;letter-spacing:0.18em;text-transform:uppercase;color:var(--muted);margin-bottom:14px;}
.steps-scroll{overflow-x:auto;padding-bottom:4px;}
.steps-inner{display:flex;align-items:center;gap:0;min-width:max-content;}
.st-node{display:flex;flex-direction:column;align-items:center;gap:6px;cursor:default;}
.st-dot{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;border:1px solid var(--border);background:var(--s2);transition:all 0.3s;}
.st-dot.done{background:var(--adim);border-color:var(--aglow);box-shadow:0 0 16px rgba(245,166,35,0.15);}
.st-dot.opt{opacity:0.5;border-style:dashed;}
.st-dot.opt.done{opacity:1;}
.st-label{font-size:10px;color:var(--muted);text-align:center;max-width:56px;line-height:1.3;}
.st-line{width:28px;height:1px;background:var(--border);margin-bottom:22px;flex-shrink:0;transition:background 0.3s;}
.st-line.done{background:rgba(245,166,35,0.4);}
.steps-counter{margin-top:14px;font-size:13px;color:var(--muted);}
.steps-counter b{color:var(--amber);}
.steps-km{font-size:12px;color:var(--muted2);margin-top:4px;}

/* MAIN SECTIONS */
.main{padding:0 1.5rem;}
.sec-title{font-family:'Unbounded',sans-serif;font-size:10px;font-weight:400;letter-spacing:0.18em;text-transform:uppercase;color:var(--muted);padding:2rem 0 1rem;border-top:1px solid var(--border);}

/* TIMELINE */
.tl{display:flex;flex-direction:column;}
.tl-row{display:flex;gap:14px;}
.spine{display:flex;flex-direction:column;align-items:center;flex-shrink:0;width:48px;}
.tl-icon{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;border:1px solid var(--border);background:var(--s2);flex-shrink:0;z-index:1;}
.vline{flex:1;width:1px;background:var(--border);min-height:16px;}
.card{background:var(--s1);border:1px solid var(--border);border-radius:16px;padding:1.1rem 1.25rem;margin-bottom:12px;flex:1;min-width:0;transition:border-color 0.2s;}
.card:hover{border-color:rgba(255,255,255,0.14);}
.card.opt{border-style:dashed;opacity:0.85;}
.card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:6px;}
.card-name{font-weight:600;font-size:16px;}
.badge{font-family:'Unbounded',sans-serif;font-size:10px;font-weight:400;padding:4px 11px;border-radius:100px;white-space:nowrap;flex-shrink:0;border:1px solid;}
.ba{background:var(--adim);border-color:var(--aglow);color:var(--amber);}
.bt{background:var(--tdim);border-color:rgba(45,212,160,0.25);color:var(--teal);}
.bc{background:var(--cdim);border-color:rgba(255,107,74,0.25);color:var(--coral);}
.bk{background:var(--pdim);border-color:rgba(232,121,160,0.25);color:var(--pink);}
.br{background:var(--rdim);border-color:rgba(248,113,113,0.25);color:var(--red);}
.bv{background:var(--vdim);border-color:rgba(167,139,250,0.25);color:var(--purple);}
.card-addr{font-size:12px;color:var(--muted);margin-bottom:8px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
.card-addr a{color:var(--teal);text-decoration:none;border-bottom:1px solid rgba(45,212,160,0.2);transition:border-color 0.2s;}
.card-addr a:hover{border-color:var(--teal);}
.sep{color:var(--muted2);}
.card-desc{font-size:13px;color:var(--muted);line-height:1.65;margin-bottom:8px;}
.note{font-size:12px;color:var(--muted2);font-style:italic;margin-top:6px;}
.opt-tag{font-size:11px;color:var(--amber);font-weight:500;letter-spacing:0.04em;margin-bottom:4px;}
.chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:6px;}
.chip{font-size:12px;padding:3px 10px;border-radius:100px;background:rgba(255,255,255,0.04);border:1px solid var(--border);color:var(--muted);}

/* WALK */
.walk{display:flex;align-items:center;gap:10px;padding:4px 0 4px 62px;font-size:12px;color:var(--muted2);margin-bottom:4px;}
.wline{width:40px;height:1px;background:var(--border);}

/* MATCH BANNER */
.match{margin:0.5rem 0 1rem;background:var(--s1);border:1px solid rgba(45,212,160,0.2);border-radius:16px;padding:1.25rem 1.5rem;display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
.match-teams{font-family:'Unbounded',sans-serif;font-size:20px;font-weight:700;display:flex;align-items:center;gap:10px;}
.match-vs{font-size:11px;color:var(--muted);font-weight:400;}
.match-info{margin-left:auto;text-align:right;}
.match-time{font-size:18px;font-weight:600;color:var(--teal);}
.match-sub{font-size:12px;color:var(--muted);margin-top:2px;}
.match-wc{font-size:11px;color:var(--muted2);margin-top:1px;}

/* PARTICIPANTS */
.pg{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;padding-bottom:2rem;}
.pc{background:var(--s1);border:1px solid var(--border);border-radius:16px;padding:1.1rem 1rem;display:flex;flex-direction:column;align-items:center;text-align:center;gap:8px;transition:transform 0.15s,border-color 0.2s;cursor:default;}
.pc:hover{transform:translateY(-2px);border-color:rgba(255,255,255,0.14);}
.av{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Unbounded',sans-serif;font-size:14px;font-weight:700;}
.pname{font-weight:600;font-size:14px;}
.pst{font-size:12px;padding:3px 11px;border-radius:100px;font-weight:500;border:1px solid;}
.sgo{background:var(--gdim);color:var(--green);border-color:rgba(74,222,128,0.3);}
.snope{background:var(--rdim);color:var(--red);border-color:rgba(248,113,113,0.3);}
.smaybe{background:var(--adim);color:var(--amber);border-color:var(--aglow);}
.pstops{font-size:12px;color:var(--muted);}
.sdots{display:flex;gap:4px;flex-wrap:wrap;justify-content:center;margin-top:4px;}
.sdot{width:8px;height:8px;border-radius:50%;background:var(--s2);border:1px solid var(--border);}
.sdot.on{background:var(--amber);border-color:var(--amber);}

/* FOOTER */
footer{border-top:1px solid var(--border);padding:2rem 1.5rem;text-align:center;font-size:12px;color:var(--muted2);}
footer b{color:var(--amber);}

@media(max-width:480px){
  .hero{padding:2.5rem 1rem 2rem;}
  .main{padding:0 1rem;}
  .nav{padding:0 1rem;}
  .steps-wrap{padding:1.25rem 1rem;}
  .match{padding:1rem;}
  .nav-links a{font-size:11px;padding:4px 8px;}
}
</style>
</head>
